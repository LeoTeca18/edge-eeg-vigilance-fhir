# ==============================================================================
# .gitignore — Edge-First EEG Vigilance Architecture
# ==============================================================================
# This file prevents sensitive credentials, build artifacts, runtime data,
# operating-system metadata, and IDE configuration from being committed to
# version control.
# ==============================================================================

# ---------- Python runtime artifacts ----------
# Bytecode caches generated by the Python interpreter on import.
# They are machine-specific and must never be version-controlled.
__pycache__/
*.py[cod]
*$py.class

# C extensions compiled from Cython or C source files
*.so

# ---------- Distribution / packaging ----------
# Generated when building pip packages (sdist / wheel / egg).
dist/
build/
*.egg-info/
*.egg

# ---------- Virtual environments ----------
# Local Python virtual environments that contain site-packages and binaries.
# Each developer creates their own; tracking them would bloat the repo and
# introduce path / OS incompatibilities.
venv/
.venv/
env/
ENV/

# ---------- IDE / editor configuration ----------
# Per-developer settings for VS Code, PyCharm / JetBrains, and others.
# These include personal formatting rules, run configurations, and workspace
# metadata that should remain local.
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---------- Test & coverage artifacts ----------
# Pytest caches, coverage reports, and mypy / type-checker caches.
.pytest_cache/
htmlcov/
.coverage
.coverage.*
*.cover
.mypy_cache/
.ruff_cache/

# ---------- Jupyter Notebook ----------
# Checkpoint files created by Jupyter; they duplicate notebook state.
.ipynb_checkpoints/

# ---------- Eclipse Mosquitto runtime data ----------
# The Mosquitto MQTT broker writes persistence databases and log files at
# runtime. These are ephemeral and container-specific; committing them would
# leak runtime message payloads and connection metadata.
mosquitto/data/
mosquitto/log/

# ---------- Docker ----------
# Override files often contain local port mappings or environment variables.
docker-compose.override.yml

# ---------- Environment variables & secrets ----------
# .env files frequently store MQTT credentials, API keys, broker passwords,
# FHIR server tokens, and other secrets that MUST NEVER be committed.
.env
.env.*
*.env
secrets/
credentials/

# ---------- EEG session data files ----------
# Raw or exported EEG session recordings (Excel, CSV) may contain personally
# identifiable patient/subject data (PHI/PII) and must be excluded from
# version control to comply with data protection regulations.
*.xlsx
*.xls
*.csv
data/
datasets/

# ---------- Operating-system metadata ----------
# macOS Finder metadata and Windows thumbnail caches.
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Log files ----------
# Application log output generated at runtime.
*.log
logs/
